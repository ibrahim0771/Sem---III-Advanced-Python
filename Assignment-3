from abc import ABC, abstractmethod

class PaymentMode(ABC):

    @abstractmethod
    def make_payment(self, amount):
        pass


class CardPayment(PaymentMode):

    def make_payment(self, amount):
        print(f"Payment of ${amount} processed using Credit Card.")


class BankCardPayment(PaymentMode):

    def make_payment(self, amount):
        print(f"Payment of ${amount} processed using Debit Card.")


class DigitalPayment(PaymentMode):

    def make_payment(self, amount):
        print(f"Payment of ${amount} processed using UPI.")


class OnlineBankPayment(PaymentMode):

    def make_payment(self, amount):
        print(f"Payment of ${amount} processed using Net Banking.")


class PaymentService:

    def __init__(self, mode=None):
        self.mode = mode

    def change_mode(self, mode):
        self.mode = mode

    def execute_payment(self, amount):
        if self.mode is None:
            print("Please select a payment method.")
        else:
            self.mode.make_payment(amount)


service = PaymentService()

while True:
    print("\n===== Payment Processing System =====")
    print("1. Credit Card")
    print("2. Debit Card")
    print("3. UPI")
    print("4. Net Banking")
    print("5. Exit")

    option = int(input("Enter your choice: "))

    if option == 5:
        print("Thank you for using the Payment System!")
        break

    amount = float(input("Enter payment amount: "))

    if option == 1:
        service.change_mode(CardPayment())
    elif option == 2:
        service.change_mode(BankCardPayment())
    elif option == 3:
        service.change_mode(DigitalPayment())
    elif option == 4:
        service.change_mode(OnlineBankPayment())
    else:
        print("Invalid choice!")
        continue

    service.execute_payment(amount)
